<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         List view
         ================================================================ -->
    <record id="view_project_task_work_session_list" model="ir.ui.view">
        <field name="name">project.task.work.session.list</field>
        <field name="model">project.task.work.session</field>
        <field name="arch" type="xml">
            <list string="Work Sessions" default_order="start_datetime desc">
                <field name="task_id"/>
                <field name="project_id" optional="hide"/>
                <field name="partner_id" optional="hide" string="Customer"/>
                <field name="employee_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration" widget="float_time" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'running'"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'paused'"
                       decoration-muted="state in ('transferred', 'cancelled')"/>
                <field name="closed_by"/>
                <field name="closed_on"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Form view
         ================================================================ -->
    <record id="view_project_task_work_session_form" model="ir.ui.view">
        <field name="name">project.task.work.session.form</field>
        <field name="model">project.task.work.session</field>
        <field name="arch" type="xml">
            <form string="Work Session">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="task_id" placeholder="Task"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="pause_reason"/>
                            <field name="transfer_reason"/>
                        </group>
                        <group>
                            <field name="closed_by"/>
                            <field name="closed_on"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Search view
         ================================================================ -->
    <record id="view_project_task_work_session_search" model="ir.ui.view">
        <field name="name">project.task.work.session.search</field>
        <field name="model">project.task.work.session</field>
        <field name="arch" type="xml">
            <search string="Search Work Sessions">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="partner_id" string="Customer"/>
                <field name="employee_id"/>
                <field name="user_id"/>

                <filter string="Currently Working" name="filter_currently_working"
                        domain="[('state', '=', 'running')]"/>
                <filter string="Running" name="filter_running"
                        domain="[('state', '=', 'running')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Paused" name="filter_paused"
                        domain="[('state', '=', 'paused')]"/>
                <filter string="Transferred" name="filter_transferred"
                        domain="[('state', '=', 'transferred')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <filter string="Start Date" name="filter_start_date"
                        date="start_datetime"/>

                <group expand="0" string="Group By">
                    <filter string="Employee" name="groupby_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Task" name="groupby_task"
                            context="{'group_by': 'task_id'}"/>
                    <filter string="Project" name="groupby_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Customer" name="groupby_customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="State" name="groupby_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="groupby_start_date"
                            context="{'group_by': 'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         PART 9: Pivot + Graph for the Work Session Report/dashboard.
         Duration is the natural measure; Employee/Project/Customer/
         Task/State/Date are all already real, stored, indexed fields -
         no new aggregation model needed.
         ================================================================ -->
    <record id="view_project_task_work_session_pivot" model="ir.ui.view">
        <field name="name">project.task.work.session.pivot</field>
        <field name="model">project.task.work.session</field>
        <field name="arch" type="xml">
            <pivot string="Work Session Analysis">
                <field name="employee_id" type="row"/>
                <field name="start_datetime" interval="week" type="col"/>
                <field name="duration" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="view_project_task_work_session_graph" model="ir.ui.view">
        <field name="name">project.task.work.session.graph</field>
        <field name="model">project.task.work.session</field>
        <field name="arch" type="xml">
            <graph string="Hours by Employee" type="bar">
                <field name="employee_id" type="row"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         PART 9: "Currently Working" - only running sessions, with the
         live (non-stored) elapsed_hours column. See elapsed_hours'
         own docstring in the model for why it isn't stored.
         ================================================================ -->
    <record id="view_project_task_work_session_currently_working_list" model="ir.ui.view">
        <field name="name">project.task.work.session.currently.working.list</field>
        <field name="model">project.task.work.session</field>
        <field name="arch" type="xml">
            <list string="Currently Working" default_order="start_datetime asc" create="false">
                <field name="employee_id"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="partner_id" string="Customer"/>
                <field name="start_datetime" string="Started At"/>
                <field name="elapsed_hours" widget="float_time" string="Elapsed"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Action + menu (Project > Reporting area) so the model is
         reachable for manual testing in Part 3. Buttons/automation
         will be added in later parts - this is a plain CRUD list for
         now, gated by the access rights in security/ir.model.access.csv.
         ================================================================ -->
    <record id="action_project_task_work_session" model="ir.actions.act_window">
        <field name="name">Work Sessions</field>
        <field name="res_model">project.task.work.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_task_work_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No work sessions yet.
            </p>
            <p>
                Work sessions are normally created automatically when an
                employee starts/pauses/resumes a task. That automation
                is not implemented yet - for now, sessions can be
                created here manually for testing.
            </p>
        </field>
    </record>

    <!--
        A small, self-contained menu owned entirely by this module,
        rather than guessing at a core Project menu's external ID
        (which varies across Odoo versions and would break install if
        wrong). This can be relocated under a Project submenu once the
        correct target is confirmed against your actual Odoo 18
        instance - see the install notes for how to find it.
    -->
    <menuitem id="menu_project_task_service_management_root"
              name="Service Task Management"
              sequence="60"/>

    <menuitem id="menu_project_task_work_session"
              name="Work Sessions"
              parent="menu_project_task_service_management_root"
              action="action_project_task_work_session"
              sequence="10"/>

</odoo>
